DTSTART;TZID=Asia/Novosibirsk:20260809T212500
DTEND;TZID=Asia/Novosibirsk:20260809T220500
RRULE:FREQ=WEEKLY;BYDAY=SU
SUMMARY:Revisión semanal
DESCRIPTION:Peso promedio de la semana\, fotos si toca\, adherencia. Plan
 ea la semana que entra. Aquí se ajusta el plan con datos\, no con sensa
 ciones.
BEGIN:VALARM
ACTION:DISPLAY
TRIGGER:-PT5M
